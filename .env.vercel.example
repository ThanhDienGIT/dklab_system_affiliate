# Dan cac bien nay vao Vercel -> Project -> Settings -> Environment Variables
# ---------- Supabase (Postgres) ----------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (cong 6543). Thay [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.givhfbkzjwqbmxifbohq:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Dung cho migration/seed: "Session pooler" (cong 5432, IPv4) cung user postgres.<ref>. Khong dat -> dung DATABASE_URL.
DIRECT_URL=postgresql://postgres.givhfbkzjwqbmxifbohq:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://givhfbkzjwqbmxifbohq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_GykGyte3PaiMwPzRZhDp7Q_Dd8s2plS
# Tuy chon, CHI server, bo qua RLS (Supabase -> Settings -> API Keys -> Secret key). KHONG dat NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------- Cloudinary (luu anh) ----------
UPLOAD_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=            # Cloudinary Console -> Dashboard -> "Cloud name" (KHONG phai ten API key)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=system_clothes

# ---------- Ung dung ----------
AUTH_SECRET=                      # >= 32 ky tu ngau nhien:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PII_ENCRYPTION_KEY=               # 32 byte base64:           node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_URL=https://ten-mien-cua-ban.vercel.app
DB_POOL_MAX=1                     # serverless: moi instance 1 ket noi
TRUST_PROXY=true
# Tuy chon
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Lan deploy dau: bat 2 bien nay de tu tao bang + RLS + du lieu mau, sau do TAT DI
RUN_MIGRATIONS=1
SEED_ON_BUILD=1
SEED_ADMIN_EMAIL=admin@ten-mien-cua-ban.com
SEED_ADMIN_PASSWORD=              # dat mat khau manh, doi ngay sau khi dang nhap
SEED_DEMO_USER=false

# Blog AI: tim trang tham khao (chon 1 trong 2). Tavily: https://tavily.com
TAVILY_API_KEY=""
# hoac Google Programmable Search
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
