# ===== Bat buoc =====
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/eleonore"
# openssl rand -base64 48
AUTH_SECRET="doi-chuoi-nay-it-nhat-32-ky-tu-ngau-nhien"
# openssl rand -base64 32  (khoa AES-256-GCM ma hoa CCCD)
PII_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
APP_URL="http://localhost:3000"

# ===== Tai khoan admin dau tien (seed) =====
SEED_ADMIN_EMAIL="admin@eleonore.vn"
SEED_ADMIN_PASSWORD="Eleonore@2026"

# ===== Dang nhap Google (tuy chon) =====
# Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== AI tim kiem (tuy chon - khong co key van chay bang bo phan tich luat) =====
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ===== Supabase (tuy chon: dung Supabase lam Postgres + supabase-js) =====
# DIRECT_URL = ket noi cho migration (Session pooler :5432). Khong dat -> dung DATABASE_URL
DIRECT_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ===== Upload anh =====
# local = ghi vao UPLOAD_DIR (Docker volume) | inline = data-URL trong DB | cloudinary = CDN (khuyen dung cho Vercel)
UPLOAD_DRIVER="local"
UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="system_clothes"

# ===== Khac =====
DB_POOL_MAX="5"
# true khi chay sau reverse proxy (Caddy/Nginx/Vercel) de lay dung IP tu X-Forwarded-For
TRUST_PROXY="true"

# Blog AI: tim trang tham khao (chon 1 trong 2). Tavily: https://tavily.com
TAVILY_API_KEY=""
# hoac Google Programmable Search
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""

# ---- Gửi mail xác thực (chọn 1 provider, miễn phí) ----
# brevo (khuyên dùng: 300 mail/ngày, không cần domain) | resend | gmail
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Éleonore
# true = bắt buộc xác thực email mới được đăng nhập (khách hàng)
REQUIRE_VERIFIED_EMAIL=false

# ---- Chống spam dùng chung giữa các instance Vercel (Upstash Redis free) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Trần số lần gọi LLM search/giờ toàn hệ thống
LLM_SEARCH_HOURLY_CAP=600

# ---- Blog AI: tìm web (tuỳ chọn) ----
TAVILY_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
